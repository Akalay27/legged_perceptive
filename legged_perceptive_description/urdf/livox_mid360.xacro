<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define properties for laser sensor -->
  <xacro:property name="M_PI" value="3.14159"/> 
  <xacro:property name="laser_min_range" value="0.1"/>
  <xacro:property name="laser_max_range" value="200.0"/>
  <xacro:property name="samples" value="24000"/>
  <xacro:property name="downsample" value="1"/>
  
  <!-- Define null inertial for lighter links -->
  <xacro:macro name="null_inertial">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </xacro:macro>

  <!-- Livox Mid360 sensor macro with unique naming -->
  <xacro:macro name="Livox_Mid360" params="name parent *origin ros_topic:=livox visualize:=False update_rate:=10 resolution:=0.002 noise_mean:=0.0 noise_stddev:=0.01">

    <!-- Sensor Link with Unique Name -->
    <link name="${name}_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 -0.0076"/>
        <mass value="0.270"/>
        <inertia
          ixx="${(2 * 0.270) / 5.0 * (0.022 * 0.022)}"
          ixy="0.0"
          ixz="0.0"
          iyy="${(2 * 0.270) / 5.0 * (0.022 * 0.022)}"
          iyz="0.0"
          izz="${(2 * 0.270) / 5.0 * (0.022 * 0.022)}"/>
      </inertial>
      
      <!-- Visual using Sphere -->
      <visual>
        <origin rpy="0 0 0" xyz="0 0 -0.0076"/>
        <geometry>
          <sphere radius="0.022"/>
        </geometry>
        <material>
          <color rgba="0.0 0.0 0.5 0.5"/>
        </material>
      </visual>
      
      <!-- Optional: Add Collision Elements Here If Needed -->
      <!--
      <collision>
        <origin xyz="0 0 0.027" rpy="0 0 0"/>
        <geometry>
          <box size="0.003 0.067 0.0165"/>
        </geometry>
      </collision>
      -->
    </link>

    <!-- Fixed Joint to Attach Sensor to Parent Link -->
    <joint name="${name}_fixed_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/> <!-- Replace with actual origin if different -->
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <!-- Gazebo Sensor Plugin for Visualization and Sensor Properties -->
    <gazebo reference="${name}_link">
      <self_collide>1</self_collide>
      <material>Gazebo/Blue</material>
      <sensor type="ray" name="${name}_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>${visualize}</visualize>
        <update_rate>${update_rate}</update_rate>
        <plugin name="gazebo_ros_laser_controller" filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>${2 * M_PI}</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>${-7.22 / 180 * M_PI}</min_angle>
                <max_angle>${55.22 / 180 * M_PI}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${laser_min_range}</min>
              <max>${laser_max_range}</max>
              <resolution>${resolution}</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>${noise_mean}</mean>
              <stddev>${noise_stddev}</stddev>
            </noise>
          </ray>
          <visualize>${visualize}</visualize>
          <samples>${samples}</samples>
          <downsample>${downsample}</downsample>
          <publish_pointcloud_type>2</publish_pointcloud_type>
          <frameName>${name}_link</frameName>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <ros_topic>${ros_topic}</ros_topic>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

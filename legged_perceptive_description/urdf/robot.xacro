<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">
    <xacro:arg name="sim" default="false"/>

    <xacro:include filename="$(find legged_unitree_description)/urdf/robot.xacro"/>

    <xacro:include filename="$(find legged_perceptive_description)/urdf/sensor_d435.xacro"/>
    <!-- <xacro:include filename="$(find legged_perceptive_description)/urdf/sensor_t265.xacro"/> -->
    <xacro:include filename="$(find legged_perceptive_description)/urdf/sensor_mid360.xacro"/>
    <!-- <xacro:include filename="$(find legged_perceptive_description)/urdf/livox_mid360.xacro"/> -->

    <!-- <xacro:sensor_d435 name="front_camera" topics_ns="front_camera" parent="base">
           <origin xyz="0.31 -0.0 0.11" rpy="3.141 0.38 0"/>
    </xacro:sensor_d435> -->

    <!-- <xacro:sensor_t265 name="tracking_camera" topics_ns="tracking_camera" parent="base">
        <origin xyz="0.16 0 0.085" rpy="0 -1.04 0"/>
    </xacro:sensor_t265> -->




    <xacro:sensor_mid360 name="livox_front" topics_ns="lidar_192_168_1_105" parent="base" xyz="0.25 0 0.350" rpy="0 0.5 0" sim="true"/>

